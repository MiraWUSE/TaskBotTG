# Создайте .env рядом с этим файлом и вставьте токен, полученный от @BotFather.
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# IANA-часовой пояс для новых пользователей.
BOT_TIMEZONE=Europe/Moscow

# Локальный путь к SQLite. В Docker Compose заменяется на /app/data/bot.sqlite3.
DATABASE_PATH=data/bot.sqlite3

# Интервал проверки наступивших напоминаний, секунды.
REMINDER_POLL_SECONDS=5

# Срок резервирования отправки: должен превышать TELEGRAM_TIMEOUT_SECONDS.
REMINDER_LEASE_SECONDS=120
TELEGRAM_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
